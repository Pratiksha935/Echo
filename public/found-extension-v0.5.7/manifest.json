{
  "manifest_version": 3,
  "name": "Found — Organisational Memory",
  "version": "0.5.7",
  "description": "Surfaces relevant organisational knowledge while you browse.",
  "permissions": ["activeTab", "storage", "identity"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "css": ["content.css", "update.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Found",
    "default_popup": "popup.html"
  },
  "background": { "service_worker": "background.js" }
}
